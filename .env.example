# Salin ke .env lalu isi. .env TIDAK di-commit.
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Google Nano Banana (Gemini) — opsional, untuk fitur AI di dashboard admin
# Dapatkan di https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# Supabase (PostgreSQL Cloud) — untuk penyimpanan orders & invoice transaksi
# Dapatkan di https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Tokopay.id Payment Gateway (QRIS & Virtual Account)
# Dapatkan di https://tokopay.id/merchant/integration
TOKOPAY_MERCHANT_ID=M2409...
TOKOPAY_SECRET_KEY=sec_...
