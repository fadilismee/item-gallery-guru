# Salin ke .env lalu isi. .env TIDAK di-commit.
ADMIN_PASSWORD=ganti-dengan-password-kuat
# Secret 2FA TOTP 32 karakter base32 (Google Authenticator).
# Kosongkan untuk menonaktifkan langkah kode. Contoh: ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# Google Nano Banana (Gemini) — opsional, untuk fitur AI di dashboard admin
# Dapatkan di https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# Supabase (PostgreSQL Cloud) — untuk penyimpanan orders & invoice transaksi
# Dapatkan di https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Tripay Payment Gateway (QRIS, VA & E-Wallet)
# Dapatkan di https://tripay.co.id/developer
TRIPAY_MERCHANT_CODE=T35186
TRIPAY_API_KEY=DEV-crOy...
TRIPAY_PRIVATE_KEY=IDjFa-...
